<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>navstress_agent</name>
  <version>0.1.0</version>
  <description>LLM stress-test agent: proposes scenarios, runs batches, narrows onto the weakest family.</description>
  <maintainer email="amacharla@csuchico.edu">Akshith Macharla</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>navstress_eval</exec_depend>
  <exec_depend>navstress_scenarios</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
