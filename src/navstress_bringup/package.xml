<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>navstress_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and parameters that wire NavStress to Isaac Sim + Nav2, or to the CI fake simulator.</description>
  <maintainer email="amacharla@csuchico.edu">Akshith Macharla</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>navstress_eval</exec_depend>
  <exec_depend>navstress_fakesim</exec_depend>
  <exec_depend>navstress_monitor</exec_depend>
  <exec_depend>navstress_scenarios</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>domain_coordinator</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>navstress_agent</test_depend>
  <test_depend>navstress_report</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>rosbag2_py</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
