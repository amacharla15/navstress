# Copy to .env (never commit .env). Placeholders only.

# Any OpenAI-compatible chat-completions endpoint. Default below is Google's
# Gemini OpenAI-compatibility endpoint; confirm the model id with
#   ros2 run navstress_agent stress_agent --list-models
NAVSTRESS_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
NAVSTRESS_LLM_MODEL=replace-with-a-model-id-from-list-models
NAVSTRESS_LLM_API_KEY=replace-with-your-key

# Where results/<run_id>/ directories are written (default: ./results)
NAVSTRESS_RESULTS_DIR=./results

# Recorded into run metadata; set on the pod (see docs/RUNPOD.md)
NAVSTRESS_ISAAC_SIM_VERSION=6.2.0
